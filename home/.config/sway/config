include /etc/sway/config.d/*
include ~/.config/sway/outputs.d/*
include ~/.config/sway/settings

set $script_dir /usr/local/bin

exec dbus-update-activation-environment --systemd --all
exec systemctl --user start sway-session.target

# **/ Variables /**

# Terminal
set $terminal alacritty

# File manager
set $file_browser thunar

# Terminal File Manager
set $terminal_filemanager nnn

# Emoji Manager
set $emoji rofmoji

# Web browser
set $web_browser firefox

# Launcher
set $launcher rofi -show drun

# Workspaces
set $ws1  1
set $ws2  2
set $ws3  3
set $ws4  4
set $ws5  5
set $ws6  6
set $ws7  7
set $ws8  8
set $ws9  9
set $ws10 10

# **/ GTK Settings /**
exec_always {
    gsettings set org.gnome.desktop.interface gtk-theme $gtk_theme
    gsettings set org.gnome.desktop.interface icon-theme $icon_theme
    gsettings set org.gnome.desktop.interface font-name $font
    gsettings set org.gnome.desktop.interface monospace-font-name $monospace_font
    gsettings set org.gnome.desktop.wm.preferences button-layout ':'
    gsettings set org.gnome.desktop.interface cursor-theme $cursor_theme
    gsettings set org.gnome.desktop.interface cursor-size $cursor_size
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.2
    gsettings set org.gnome.desktop.interface font-antialiasing 'grayscale'

    flatpak override --user --env=GTK_THEME=$gtk_theme
    flatpak override --user -env=ICON_THEME=$icon_theme
}

seat seat0 xcursor_theme $cursor_theme $cursor_size

# **/ Idle Configuration /**
exec swayidle -w \
    timeout 310 $script_dir/lock \
    timeout 300 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep $script_dir/lock

for_window [class="^.*"] inhibit_idle fullscreen
for_window [app_id="^.*"] inhibit_idle fullscreen
for_window [app_id="gamescope"] inhibit_idle focus

# **/ Input Configuration /**
input type:pointer {
    accel_profile "flat"
    pointer_accel 0.1
}

input type:touchpad {
    accel_profile adaptive
    drag enabled
    dwt enabled
    natural_scroll disabled
    tap enabled
}

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:win_space_toggle"
}

# **/ Output Configuration /**

# Wallpaper
output * bg ~/.local/share/backgrounds/wallpaper_field.jpg fill

# **/ Window Decorations /**
gaps inner 5
gaps outer 0
default_border pixel 2
default_floating_border pixel 2

# Floating Rules
for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable

for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="galculator"] floating enable
for_window [app_id="gamescope"] floating enable
for_window [instance="gufw.py"] floating enable

# **/ Keybinds /**

# Lock a session
bindsym $mod+l exec hyprlock

# Start a terminal
bindsym $mod+t exec $terminal

# Start browser
bindsym $mod+b exec $web_browser

# Start emoji manager
bindsym $mod+period exec $emoji

# Start file manager
bindsym $mod+f exec $file_browser

# Start terminal file manager
bindsym $mod+Mod1+f exec $terminal -e $terminal_filemanager

# Screenshot
bindsym $mod+Shift+s exec ~/.local/bin/screenshot

# Kill focused window
bindsym $mod+q kill
bindsym Mod1+F4 kill

# Start launcher
bindsym $mod+Return exec $launcher 

floating_modifier $mod normal

# Reload sway
bindsym $mod+Shift+c reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Mod1+$left move left
bindsym $mod+Mod1+$down move down
bindsym $mod+Mod1+$up move up
bindsym $mod+Mod1+$right move right

# Workspace keybinds
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Layout Keybinds
bindsym $mod+h splith
bindsym $mod+v splitv

# Toggle the current focus between tiling and floating mode
bindsym $mod+Mod1+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+Shift+space focus mode_toggle

# Utily Action Keybinds

# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle && $script_dir/volume-notification
bindsym --locked XF86AudioLowerVolume exec $script_dir/volume-decrease
bindsym --locked XF86AudioRaiseVolume exec $script_dir/volume-increase

# Special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec $script_dir/brightness-decrease
bindsym --locked XF86MonBrightnessUp exec $script_dir/brightness-increase

# Special key to take a screenshot with grim
# bindsym Print exec $script_dir/screenshot-menu

# Display power menu
bindsym --release $mod+Mod1+q exec $script_dir/power-menu

# **/ Status Bar /**
bar {
    position top

    swaybar_command waybar
    
    icon_theme $icon_theme

    colors {
        statusline $fg
        background $bg
        #                   border  bg      text
        focused_workspace   $accent $accent $bg
        inactive_workspace  $bg     $bg     $fg
        urgent_workspace    $bg     $bg     $fg
    }
}

# **/ Window Colors /**
# class                 border  backgr. text    indicator child_border
client.focused          $accent $bg     $fg     $accent   $accent
client.focused_inactive $bg     $bg     $fg     $bg       $bg
client.unfocused        $bg     $bg     $fg     $bg       $bg
client.urgent           $bg     $bg     $fg     $bg       $bg
client.placeholder      $bg     $bg     $fg     $bg       $bg

client.background       $bg

# **/ Autostart /**

exec_always {
    pidof /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 || /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
    pidof nm-applet || nm-applet
    pidof dunst || dunst
    #pidof steam || env GDK_DPI_SCALE=$dpi_scale steam -silent
    pidof keepassxc || keepassxc
}

for_window [app_id="calendar-popup"] floating enable, border pixel 1, move position cursor, move left 130 px, move down 20 px

exec sway-audio-idle-inhibit
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

exec sway-audio-idle-inhibit
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen
