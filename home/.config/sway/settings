# Modifier key
set $mod Mod4
# Direction keys
set $left a
set $down s
set $up w
set $right d

# Terminal
set $terminal alacritty

# File manager
set $file_browser thunar

# Terminal File Manager
set $terminal_filemanager nnn

# Emoji Manager
set $emoji rofimoji

# Web browser
set $web_browser firefox

# Color Picker
set $color hyprpicker --autocopy

# Screenshooter
set $screenshot ~/.local/bin/screenshot

# Launcher
set $launcher rofi -show drun

# Colors
set $accent #afa193
set $bg #101010
set $bg-alt #252525
set $fg #f6f1ea

# GTK theme settings
set $font "Ubuntu Regular 10"
set $monospace_font "JetBrainsMono Nerd Font 10"
set $icon_theme "Papirus-Dark"
set $gtk_theme "Yaru-Amber-dark"
set $cursor_theme "Adwaita"
set $cursor_size 32
set $dpi_scale 1.6

# Font
font pango: JetBrainsMono Nerd Font 16
